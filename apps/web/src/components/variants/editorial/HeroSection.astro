---
import config from '@eventos/config'
---

<!-- Editorial Hero: Image takes 60% with text overlapping -->
<section class="relative min-h-screen flex items-end overflow-hidden">
  <div class="absolute inset-0 bg-[var(--color-secondary)]">
    <div class="absolute inset-0 opacity-20" style="background: linear-gradient(180deg, transparent 0%, var(--color-secondary) 100%)"></div>
  </div>

  <div class="relative z-10 w-full pb-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h1
        class="font-bold text-white mb-6 leading-none"
        style={`font-family: var(--font-display); font-size: clamp(64px, 8vw, 120px)`}
      >
        {config.content.heroHeadline}
      </h1>

      <p class="text-xl md:text-2xl text-white/70 mb-10 max-w-2xl leading-relaxed">
        {config.content.heroSubHeadline}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={config.content.heroCta1Href} class="btn-primary px-8 py-4 text-base">
          {config.content.heroCta1Label}
        </a>
        <a href={config.content.heroCta2Href} class="btn-outline px-8 py-4 text-base border-white/30 text-white hover:bg-white hover:text-[var(--color-secondary)]">
          {config.content.heroCta2Label}
        </a>
      </div>
    </div>
  </div>
</section>
