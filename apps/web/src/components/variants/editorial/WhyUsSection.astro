---
import config from '@eventos/config'
---

<section class="relative section-padding overflow-hidden bg-[var(--color-bg)]" id="why-choose-us">
  <div class="container-narrow relative z-10 px-6 md:px-0">
    <div class="flex flex-col md:flex-row items-center justify-between gap-16 md:gap-32 h-full">
      <!-- High-Impact Image Bleed -->
      <div class="relative w-full md:w-1/2 aspect-[3/4] overflow-hidden reveal-left">
          <img 
            src="/brand/why-us-editorial.jpg" 
            alt="The Precision of Craft" 
            class="w-full h-full object-cover opacity-80"
            onerror="this.src='https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?q=80&w=2070&auto=format&fit=crop'"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)] to-transparent opacity-40"></div>
          <div class="absolute bottom-8 right-8 text-[var(--color-text)] text-xs font-bold uppercase tracking-[0.4em] transform rotate-90 origin-bottom-right">Craftsmanship</div>
      </div>

      <!-- Principles Grid -->
      <div class="w-full md:w-1/2">
        <h2 class="text-xs md:text-sm font-bold text-[var(--color-primary)] uppercase tracking-[0.5em] mb-12 block reveal" style="animation-delay: 0.2s;">
            Our Principles
        </h2>

        <div class="space-y-16">
          {config.content.whyUsPoints.map((point, index) => (
            <div class="flex gap-8 md:gap-12 reveal" style={`animation-delay: ${0.4 + index * 0.2}s;`}>
               <div class="flex flex-col items-center">
                  <span class="text-4xl md:text-6xl font-bold text-[var(--color-primary-20)]" style="font-family: var(--font-display);">0{index + 1}</span>
                  <div class="w-px h-full bg-[var(--color-primary-10)] mt-4"></div>
               </div>
               
               <div class="flex flex-col pt-4">
                  <h3 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight uppercase" style="font-family: var(--font-display);">
                    {point.title}
                  </h3>
                  <p class="text-sm md:text-base text-[var(--color-text-muted)] leading-relaxed max-w-sm">
                    {point.body}
                  </p>
               </div>
            </div>
          ))}
        </div>

        <div class="mt-20 pt-16 border-t border-[var(--color-primary-10)] reveal">
            <a href="/about" class="inline-flex items-center gap-6 group">
                <span class="text-[var(--color-primary)] text-xs font-bold uppercase tracking-[0.3em]">Read the Narrative</span>
                <svg class="w-8 h-8 md:w-12 md:h-12 text-[var(--color-primary)] transform group-hover:translate-x-2 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Monolithic shadow typography -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 text-[15vw] font-bold text-[var(--color-primary-rgb)] opacity-[0.02] pointer-events-none select-none whitespace-nowrap" style="font-family: var(--font-display);">
     ESTABLISHED EXCELLENCE
  </div>
</section>
