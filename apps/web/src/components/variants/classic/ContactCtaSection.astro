---
import config from '@eventos/config'
---

<section class="relative overflow-hidden" id="contact-cta" style="background: var(--color-secondary)">
  <!-- Decorative -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full" style="background: radial-gradient(circle, var(--color-primary), transparent 70%); transform: translate(40%, -40%);"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full" style="background: radial-gradient(circle, var(--color-accent), transparent 70%); transform: translate(-30%, 30%);"></div>
  </div>

  <div class="section-padding container-narrow mx-auto relative z-10">
    <div class="max-w-3xl mx-auto text-center reveal">
      <p class="text-xs font-bold uppercase tracking-[0.25em] mb-6" style="color: var(--color-primary)">
        Let's Get Started
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: var(--font-display)">
        {config.content.ctaHeadline}
      </h2>
      <p class="text-lg md:text-xl text-white/60 mb-10 max-w-xl mx-auto leading-relaxed">
        {config.content.ctaBody}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary text-base px-10 py-4 group">
          {config.content.ctaLabel}
          <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {config.features.whatsapp.enabled && (
          <a
            href={`https://wa.me/${config.features.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(config.features.whatsapp.defaultMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 font-semibold text-white border-2 border-white/20 hover:border-white/50 hover:bg-white/5 transition-all duration-300 text-base"
            style="border-radius: var(--radius-button)"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.11.546 4.093 1.504 5.818L0 24l6.335-1.632A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.776 9.776 0 01-5.283-1.543l-.378-.225-3.922 1.01 1.04-3.791-.247-.395A9.822 9.822 0 012.182 12c0-5.416 4.402-9.818 9.818-9.818S21.818 6.584 21.818 12s-4.402 9.818-9.818 9.818z" />
            </svg>
            WhatsApp Us
          </a>
        )}
      </div>
    </div>
  </div>
</section>
