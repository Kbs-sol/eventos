---
// Video showreel section — shows a YouTube/Vimeo embed or hero video
import config from '@eventos/config'
---

<section class="section-padding" id="video-showreel" style="background: var(--color-bg)">
  <div class="container-narrow mx-auto">
    <div class="section-header reveal">
      <p class="section-eyebrow">See Us In Action</p>
      <h2 class="section-title">Our Showreel</h2>
      <div class="section-divider"></div>
    </div>

    <div class="max-w-4xl mx-auto reveal">
      <div class="relative aspect-video rounded-2xl overflow-hidden group cursor-pointer" style="background: var(--color-secondary)">
        {/* Placeholder — the video URL would come from hero_slides or site_settings */}
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-2xl" style="background: var(--color-primary)">
            <svg class="w-8 h-8 ml-1" style="color: var(--color-secondary)" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
      </div>
      <p class="text-center text-sm mt-6" style="color: var(--color-text-muted)">
        Add a video URL from the admin panel to display your showreel here.
      </p>
    </div>
  </div>
</section>
