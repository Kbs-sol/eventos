---
import config from '@eventos/config'
import PortfolioGrid from '../../shared/PortfolioGrid.tsx'
---

<section class="section-padding relative" id="featured-portfolio" style="background: var(--color-surface)">
  <div class="container-narrow mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-14 md:mb-20">
      <div class="reveal">
        <p class="section-eyebrow">Our Work</p>
        <h2 class="section-title mb-2">Featured Events</h2>
        <p class="section-subtitle">A curated showcase of our finest events and celebrations.</p>
      </div>
      <a href="/portfolio" class="btn-outline self-start md:self-auto reveal-right">
        View All
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div class="reveal">
      <PortfolioGrid client:visible featured={true} limit={4} />
    </div>
  </div>
</section>
