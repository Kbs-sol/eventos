---
// Trust bar: logos of past clients or partners. Populated from DB media_assets, 
// or shows placeholder when empty.
---

<section class="py-10 md:py-14 overflow-hidden" style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);" id="trust-bar">
  <div class="container-narrow mx-auto px-4 md:px-8">
    <p class="text-center text-xs font-bold uppercase tracking-[0.2em] mb-8" style="color: var(--color-text-muted)">
      Trusted By
    </p>
    <div class="flex items-center justify-center gap-8 md:gap-16 flex-wrap opacity-40 grayscale hover:grayscale-0 hover:opacity-70 transition-all duration-500">
      {/* Placeholder logos – replaced by DB media when connected */}
      {[1,2,3,4,5].map((n) => (
        <div class="w-24 h-10 rounded bg-[var(--color-border)] flex items-center justify-center">
          <span class="text-[10px] font-medium" style="color: var(--color-text-muted)">Client {n}</span>
        </div>
      ))}
    </div>
  </div>
</section>
