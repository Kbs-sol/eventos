---
import config from '@eventos/config'
import TestimonialsCarousel from '../../shared/TestimonialsCarousel.tsx'
---

<section class="section-padding relative overflow-hidden" id="testimonials" style="background: var(--color-bg)">
  <!-- Decorative quote marks -->
  <div class="absolute top-12 left-8 text-[200px] leading-none opacity-[0.03] pointer-events-none" style="font-family: var(--font-display); color: var(--color-primary)">
    &ldquo;
  </div>

  <div class="container-narrow mx-auto relative z-10">
    <div class="section-header reveal">
      <p class="section-eyebrow">Testimonials</p>
      <h2 class="section-title">What Our Clients Say</h2>
      <div class="section-divider"></div>
      <p class="section-subtitle mx-auto">
        Real stories from real clients who trusted us with their most important moments.
      </p>
    </div>

    <div class="reveal max-w-4xl mx-auto">
      <TestimonialsCarousel client:visible />
    </div>
  </div>
</section>
