---
import config from '@eventos/config'
---

<!-- Modern Hero: 50/50 split screen -->
<section class="min-h-screen grid grid-cols-1 md:grid-cols-2">
  <!-- Left: Content -->
  <div class="flex items-center justify-center p-8 md:p-16" style="background-color: var(--color-secondary)">
    <div class="max-w-lg">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: var(--font-display)">
        {config.content.heroHeadline}
      </h1>
      <p class="text-lg text-white/70 mb-8 leading-relaxed">
        {config.content.heroSubHeadline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={config.content.heroCta1Href} class="btn-primary px-8 py-4">
          {config.content.heroCta1Label}
        </a>
        <a href={config.content.heroCta2Href} class="inline-flex items-center px-8 py-4 text-white/80 hover:text-white transition-colors font-medium">
          {config.content.heroCta2Label}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Right: Color block / image area -->
  <div class="relative" style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%)">
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-32 h-32 border-4 border-white/20 rounded-full"></div>
    </div>
  </div>
</section>
