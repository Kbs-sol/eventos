---
import config from '@eventos/config'

const currentYear = new Date().getFullYear()

const socialLinks = [
  { key: 'instagram', label: 'IG', url: config.social.instagram },
  { key: 'facebook',  label: 'FB', url: config.social.facebook },
  { key: 'linkedin',  label: 'IN', url: config.social.linkedin },
  { key: 'youtube',   label: 'YT', url: config.social.youtube },
].filter(s => s.url)

const footerLinks = [
  { label: 'Narrative', href: '/about' },
  { label: 'Exhibitions', href: '/portfolio' },
  { label: 'Collection', href: '/services' },
  { label: 'Inquiry', href: '/contact' },
  { label: 'Terms', href: '/terms' },
  { label: 'Privacy', href: '/privacy' },
]
---

<footer class="bg-[var(--color-bg)] pt-40 pb-20 border-t border-[var(--color-border)]">
  <div class="container-wide mx-auto px-6 md:px-12 lg:px-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
      
      <!-- Brand & Narrative -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-6 mb-12">
           <div class="w-16 h-16 bg-[var(--color-primary)] flex items-center justify-center">
              <span class="text-[var(--color-secondary)] font-bold text-3xl" style="font-family: var(--font-display);">E</span>
           </div>
           <div class="flex flex-col">
              <h2 class="text-2xl font-bold tracking-[0.3em] uppercase leading-tight" style="font-family: var(--font-display);">{config.company.name}</h2>
              <p class="text-[var(--color-primary)] text-[10px] uppercase tracking-[0.4em] font-bold">The Digital Curator</p>
           </div>
        </div>
        <p class="text-[var(--color-text-muted)] text-xl md:text-2xl leading-relaxed font-light max-w-lg mb-12">
            Crafting cinematic experiences across <span class="text-[var(--color-text)] font-semibold">{config.company.city}</span> for over {currentYear - config.company.founded} years.
        </p>
        <div class="flex gap-8">
            {socialLinks.map(s => (
                <a href={s.url} target="_blank" class="text-[var(--color-text)] text-xs font-bold uppercase tracking-[0.3em] hover:text-[var(--color-primary)] transition-colors">{s.label}</a>
            ))}
        </div>
      </div>

      <!-- Navigation & Catalog -->
      <div class="lg:col-span-2 lg:col-start-7">
        <h3 class="text-[10px] uppercase tracking-[0.4em] text-[var(--color-primary)] font-bold mb-10">Navigation</h3>
        <ul class="space-y-6">
          {footerLinks.slice(0, 4).map(link => (
            <li>
              <a href={link.href} class="text-[var(--color-text)] text-sm font-semibold uppercase tracking-[0.15em] hover:text-[var(--color-primary)] transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Legal -->
      <div class="lg:col-span-3 lg:col-start-10">
        <h3 class="text-[10px] uppercase tracking-[0.4em] text-[var(--color-primary)] font-bold mb-10">Contact</h3>
        <div class="space-y-8">
            <div>
               <p class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-[0.2em] mb-2">Electronic Mail</p>
               <a href={`mailto:${config.company.email}`} class="text-[var(--color-text)] text-sm font-bold tracking-[0.1em]">{config.company.email}</a>
            </div>
            <div>
               <p class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-[0.2em] mb-2">Direct Voice</p>
               <a href={`tel:${config.company.phone.replace(/\s/g,'')}`} class="text-[var(--color-text)] text-sm font-bold tracking-[0.1em]">{config.company.phone}</a>
            </div>
            <div>
               <p class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-[0.2em] mb-2">Physical Location</p>
               <p class="text-[var(--color-text)] text-sm leading-relaxed max-w-[200px]">{config.company.address}</p>
            </div>
        </div>
      </div>
    </div>

    <!-- Final Bottom Bar -->
    <div class="mt-40 pt-16 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="flex gap-10">
           {footerLinks.slice(4).map(link => (
              <a href={link.href} class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-[0.2em] hover:text-[var(--color-primary)] transition-colors">{link.label}</a>
           ))}
        </div>
        <p class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-[0.2em]">
            &copy; {currentYear} {config.company.name} &mdash; Handcrafted in {config.company.city}.
        </p>
        <div class="flex items-center gap-3">
             <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></div>
             <span class="text-[var(--color-text)] text-[9px] font-bold uppercase tracking-[0.3em]">Operational Status: Optimal</span>
        </div>
    </div>
  </div>
</footer>
