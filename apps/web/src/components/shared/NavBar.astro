---
import config from '@eventos/config'

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
]

const isTransparent = config.brand.layout.navStyle === 'transparent'
const isMinimal = config.brand.layout.navStyle === 'minimal'
---

<header
  id="main-nav"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    isTransparent ? 'bg-transparent' : 'bg-[var(--color-secondary)]',
  ]}
  data-nav-style={config.brand.layout.navStyle}
>
  <nav class="container-narrow mx-auto flex items-center justify-between px-4 md:px-8 py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 z-10">
      <img
        src={config.assets.logoLight}
        alt={config.company.name}
        class="h-10 md:h-12 w-auto nav-logo"
      />
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium tracking-wide uppercase transition-colors duration-200 hover:text-[var(--color-primary)] nav-link"
          style="color: rgba(255,255,255,0.9)"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="btn-primary text-sm px-5 py-2"
      >
        Get In Touch
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden z-10 flex flex-col gap-1.5 p-2"
      aria-label="Toggle navigation menu"
    >
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
    </button>
  </nav>

  <!-- Mobile Drawer -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 bg-[var(--color-secondary)] transform translate-x-full transition-transform duration-300 md:hidden z-40"
  >
    <div class="flex flex-col items-center justify-center h-full gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-2xl font-display text-white hover:text-[var(--color-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="btn-primary mt-4 text-lg px-8 py-3"
      >
        Get In Touch
      </a>
    </div>
  </div>
</header>

<!-- Spacer for non-transparent nav -->
{!isTransparent && <div class="h-20"></div>}

<script>
  // Scroll-based nav background
  const nav = document.getElementById('main-nav')
  const navStyle = nav?.getAttribute('data-nav-style')

  if (navStyle === 'transparent') {
    window.addEventListener('scroll', () => {
      if (!nav) return
      if (window.scrollY > 50) {
        nav.classList.remove('bg-transparent')
        nav.classList.add('bg-[var(--color-secondary)]', 'shadow-lg', 'backdrop-blur-md')
        nav.style.backgroundColor = 'var(--color-secondary)'
      } else {
        nav.classList.add('bg-transparent')
        nav.classList.remove('shadow-lg', 'backdrop-blur-md')
        nav.style.backgroundColor = 'transparent'
      }
    })
  }

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn')
  const drawer = document.getElementById('mobile-drawer')
  let isOpen = false

  menuBtn?.addEventListener('click', () => {
    isOpen = !isOpen
    if (isOpen) {
      drawer?.classList.remove('translate-x-full')
      drawer?.classList.add('translate-x-0')
      document.body.style.overflow = 'hidden'
    } else {
      drawer?.classList.remove('translate-x-0')
      drawer?.classList.add('translate-x-full')
      document.body.style.overflow = ''
    }
  })

  // Close drawer on link click
  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      isOpen = false
      drawer.classList.remove('translate-x-0')
      drawer.classList.add('translate-x-full')
      document.body.style.overflow = ''
    })
  })
</script>
