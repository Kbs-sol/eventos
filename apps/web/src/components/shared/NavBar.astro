---
import config from '@eventos/config'

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
]

const isTransparent = config.brand.layout.navStyle === 'transparent'
---

<!-- HEADER — standalone, not wrapping the drawer -->
<header
  id="main-nav"
  class:list={[
    'fixed top-0 left-0 right-0 z-[100] transition-all duration-300',
    isTransparent ? 'bg-transparent' : 'bg-[var(--color-secondary)]',
  ]}
  data-nav-style={config.brand.layout.navStyle}
>
  <nav class="container-narrow mx-auto flex items-center justify-between px-4 md:px-8 py-4">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 relative z-[101]">
      <img
        src={config.assets.logoLight}
        alt={config.company.name}
        class="h-10 md:h-12 w-auto nav-logo"
      />
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium tracking-wide uppercase transition-colors duration-200 hover:text-[var(--color-primary)] nav-link"
          style="color: rgba(255,255,255,0.9)"
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary text-sm px-5 py-2">
        Get In Touch
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden relative z-[101] flex flex-col gap-1.5 p-2"
      aria-label="Toggle navigation menu"
    >
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 hamburger-line"></span>
    </button>

  </nav>
</header>

<!-- DRAWER — completely outside the header -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-black/60 z-[98] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<div
  id="mobile-drawer"
  class="fixed top-0 right-0 h-full w-full bg-[var(--color-secondary)] z-[99] transform translate-x-full transition-transform duration-300 ease-in-out md:hidden"
>
  <!-- Close Button -->
  <button
    id="mobile-close-btn"
    class="absolute top-5 right-5 p-2 text-white"
    aria-label="Close menu"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Logo inside drawer -->
  <div class="px-8 pt-8 pb-4">
    <img
      src={config.assets.logoLight}
      alt={config.company.name}
      class="h-10 w-auto"
    />
  </div>

  <!-- Nav Links -->
  <div class="flex flex-col px-8 pt-8 gap-6">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-display text-white hover:text-[var(--color-primary)] transition-colors duration-200 border-b border-white/10 pb-6"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/contact"
      class="btn-primary mt-4 text-center text-lg px-8 py-3"
    >
      Get In Touch
    </a>
  </div>
</div>

<!-- Spacer for non-transparent nav -->
{!isTransparent && <div class="h-20"></div>}

<script>
  const nav = document.getElementById('main-nav')
  const navStyle = nav?.getAttribute('data-nav-style')
  const menuBtn = document.getElementById('mobile-menu-btn')
  const closeBtn = document.getElementById('mobile-close-btn')
  const drawer = document.getElementById('mobile-drawer')
  const overlay = document.getElementById('mobile-overlay')
  let isOpen = false

  // Scroll based nav background
  if (navStyle === 'transparent') {
    const updateNav = () => {
      if (!nav) return
      if (window.scrollY > 50) {
        nav.style.backgroundColor = 'var(--color-secondary)'
        nav.classList.add('shadow-lg')
      } else {
        nav.style.backgroundColor = 'transparent'
        nav.classList.remove('shadow-lg')
      }
    }
    window.addEventListener('scroll', updateNav, { passive: true })
  }

  // Open drawer
  function openMenu() {
    isOpen = true
    drawer?.classList.remove('translate-x-full')
    drawer?.classList.add('translate-x-0')
    overlay?.classList.remove('opacity-0', 'pointer-events-none')
    overlay?.classList.add('opacity-100', 'pointer-events-auto')
    document.body.style.overflow = 'hidden'
  }

  // Close drawer
  function closeMenu() {
    isOpen = false
    drawer?.classList.remove('translate-x-0')
    drawer?.classList.add('translate-x-full')
    overlay?.classList.remove('opacity-100', 'pointer-events-auto')
    overlay?.classList.add('opacity-0', 'pointer-events-none')
    document.body.style.overflow = ''
  }

  menuBtn?.addEventListener('click', openMenu)
  closeBtn?.addEventListener('click', closeMenu)
  overlay?.addEventListener('click', closeMenu)

  // Close on nav link click
  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu)
  })
</script>
