---
import config from '@eventos/config'

const navLinks = [
  { label: 'Narrative', href: '/about' },
  { label: 'Exhibitions', href: '/portfolio' },
  { label: 'Collection', href: '/services' },
  { label: 'Inquiry', href: '/contact' },
]

const isTransparent = config.brand.layout.navStyle === 'transparent'
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-700 ease-[cubic-bezier(0.19,1,0.22,1)] py-8"
  data-nav-style={config.brand.layout.navStyle}
>
  <nav class="container-wide mx-auto flex items-center justify-between px-6 md:px-12 lg:px-20">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-4 z-50">
      <div class="relative w-10 h-10 md:w-12 md:h-12 overflow-hidden bg-[var(--color-primary)] flex items-center justify-center">
         <span class="text-[var(--color-secondary)] font-bold text-xl md:text-2xl" style="font-family: var(--font-display);">{config.company.name.charAt(0)}</span>
         <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
      </div>
      <div class="flex flex-col">
          <span class="text-[var(--color-text)] font-bold text-sm tracking-[0.3em] uppercase leading-tight group-hover:text-[var(--color-primary)] transition-colors">{config.company.name}</span>
          <span class="text-[var(--color-text-muted)] text-[8px] uppercase tracking-[0.4em] leading-tight">{config.company.city}</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden lg:flex items-center gap-12">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative text-[10px] font-bold tracking-[0.3em] uppercase text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors duration-500 group nav-link"
        >
          {link.label}
          <span class="absolute -bottom-2 left-0 w-0 h-px bg-[var(--color-primary)] transition-all duration-500 group-hover:w-full"></span>
        </a>
      ))}
      
      <div class="h-8 w-px bg-[var(--color-primary-10)] mx-2"></div>

      <a
        href="/contact"
        class="group relative px-8 py-3 overflow-hidden border border-[var(--color-primary-20)] hover:border-[var(--color-primary)] transition-colors duration-500"
      >
        <span class="relative z-10 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-primary)] group-hover:text-[var(--color-secondary)] transition-colors duration-500">
           Request Dossier
        </span>
        <div class="absolute inset-0 bg-[var(--color-primary)] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.7,0,0.3,1)]"></div>
      </a>
    </div>

    <!-- Mobile Button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden z-50 flex flex-col items-end gap-1.5 p-2 group"
      aria-label="Toggle navigation menu"
    >
      <span class="block w-8 h-px bg-[var(--color-text)] transition-all duration-500 group-hover:bg-[var(--color-primary)] hamburger-line"></span>
      <span class="block w-5 h-px bg-[var(--color-text)] transition-all duration-500 group-hover:w-8 group-hover:bg-[var(--color-primary)] hamburger-line"></span>
      <span class="block w-6 h-px bg-[var(--color-text)] transition-all duration-500 group-hover:bg-[var(--color-primary)] hamburger-line"></span>
    </button>
  </nav>

  <!-- Mobile Drawer -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 bg-[var(--color-bg)] transform translate-y-full transition-transform duration-700 ease-[cubic-bezier(0.19,1,0.22,1)] lg:hidden z-40 flex flex-col px-12 pt-40"
  >
     <div class="text-[var(--color-primary-10)] text-9xl font-bold absolute top-20 right-0 pointer-events-none select-none" style="font-family: var(--font-display);">MENU</div>
     
     <div class="flex flex-col gap-8">
      {navLinks.map((link, index) => (
        <a
          href={link.href}
          class="text-4xl sm:text-5xl font-bold tracking-tighter text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors reveal"
          style={`font-family: var(--font-display); transition-delay: ${index * 0.1}s;`}
        >
          {link.label}
        </a>
      ))}
     </div>

     <div class="mt-auto mb-20 flex flex-col gap-6">
        <a href="/contact" class="text-[var(--color-primary)] font-bold uppercase tracking-[0.3em] text-sm">Start an Inquiry</a>
        <div class="h-px w-20 bg-[var(--color-primary)]"></div>
        <div class="text-[var(--color-text-muted)] text-[10px] tracking-[0.1em]">{config.company.phone}</div>
     </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav')
  
  window.addEventListener('scroll', () => {
    if (!nav) return
    if (window.scrollY > 100) {
      nav.classList.add('bg-[var(--color-bg)]/90', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-[var(--color-border)]')
      nav.classList.remove('py-8')
    } else {
      nav.classList.remove('bg-[var(--color-bg)]/90', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-[var(--color-border)]')
      nav.classList.add('py-8')
    }
  })

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn')
  const drawer = document.getElementById('mobile-drawer')
  let isOpen = false

  menuBtn?.addEventListener('click', () => {
    isOpen = !isOpen
    if (isOpen) {
      drawer?.classList.remove('translate-y-full')
      drawer?.classList.add('translate-y-0')
      document.body.style.overflow = 'hidden'
      // Trigger reveal animations
      drawer?.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'))
    } else {
      drawer?.classList.remove('translate-y-0')
      drawer?.classList.add('translate-y-full')
      document.body.style.overflow = ''
    }
  })
</script>
