---
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionResolver from '../components/SectionResolver.astro'
import config from '@eventos/config'
import { getSectionDefaults } from '../lib/sections'

const vis = getSectionDefaults('about')
---

<BaseLayout title="About Us">
  {/* Page hero */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden" style="background: var(--color-secondary)">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full" style="background: radial-gradient(circle, var(--color-accent), transparent 70%); transform: translate(-30%, 30%);"></div>
    </div>
    <div class="container-narrow mx-auto px-4 md:px-8 relative z-10 text-center">
      <p class="section-eyebrow text-white/60">Who We Are</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4" style="font-family: var(--font-display)">
        About {config.company.name}
      </h1>
      <p class="text-lg text-white/60 max-w-xl mx-auto">{config.company.tagline}</p>
    </div>
  </section>

  {vis['about_story']         && <SectionResolver section="story" />}
  {vis['about_missionVision'] && <SectionResolver section="missionVision" />}
  {vis['about_stats']         && <SectionResolver section="stats" />}
  {vis['about_team']          && <SectionResolver section="team" />}
</BaseLayout>
