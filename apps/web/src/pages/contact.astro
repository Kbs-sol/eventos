---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/shared/ContactForm.tsx'
import config from '@eventos/config'
---

<BaseLayout title="Contact Us">
  {/* Hero banner */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden" style="background: var(--color-secondary)">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full" style="background: radial-gradient(circle, var(--color-primary), transparent 70%); transform: translate(30%, -40%);"></div>
    </div>
    <div class="container-narrow mx-auto px-4 md:px-8 relative z-10 text-center">
      <p class="section-eyebrow text-white/60">Get In Touch</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4" style="font-family: var(--font-display)">
        Let's Plan Your Event
      </h1>
      <p class="text-lg text-white/60 max-w-xl mx-auto">
        Tell us about your vision. We'll make it happen.
      </p>
    </div>
  </section>

  <section class="section-padding" style="background: var(--color-bg)">
    <div class="container-narrow mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
        {/* Contact form */}
        <div class="lg:col-span-3">
          <div class="card p-6 md:p-10">
            <h2 class="heading-md mb-2">Send Us an Enquiry</h2>
            <p class="text-body mb-8">Fill in the details below and we'll get back to you promptly.</p>
            <ContactForm client:load />
          </div>
        </div>

        {/* Contact info sidebar */}
        <div class="lg:col-span-2 space-y-6">
          {/* Email */}
          <div class="card-flat p-6 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--color-primary-10)">
              <svg class="w-6 h-6" style="color: var(--color-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm mb-1" style="color: var(--color-text)">Email</h3>
              <a href={`mailto:${config.company.email}`} class="text-sm hover:underline" style="color: var(--color-primary)">{config.company.email}</a>
            </div>
          </div>

          {/* Phone */}
          <div class="card-flat p-6 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--color-primary-10)">
              <svg class="w-6 h-6" style="color: var(--color-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm mb-1" style="color: var(--color-text)">Phone</h3>
              <a href={`tel:${config.company.phone.replace(/\s/g, '')}`} class="text-sm hover:underline" style="color: var(--color-primary)">{config.company.phone}</a>
            </div>
          </div>

          {/* Address */}
          <div class="card-flat p-6 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--color-primary-10)">
              <svg class="w-6 h-6" style="color: var(--color-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm mb-1" style="color: var(--color-text)">Address</h3>
              <p class="text-sm" style="color: var(--color-text-muted)">{config.company.address}</p>
            </div>
          </div>

          {/* Office Hours */}
          {config.company.officeHours && (
            <div class="card-flat p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--color-primary-10)">
                <svg class="w-6 h-6" style="color: var(--color-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-sm mb-1" style="color: var(--color-text)">Office Hours</h3>
                <p class="text-sm" style="color: var(--color-text-muted)">{config.company.officeHours}</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
