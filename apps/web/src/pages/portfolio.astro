---
import BaseLayout from '../layouts/BaseLayout.astro'
import PortfolioGrid from '../components/shared/PortfolioGrid.tsx'
---

<BaseLayout title="Our Portfolio">
  {/* Page hero */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden" style="background: var(--color-secondary)">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full" style="background: radial-gradient(circle, var(--color-primary), transparent 70%); transform: translate(40%, -40%);"></div>
    </div>
    <div class="container-narrow mx-auto px-4 md:px-8 relative z-10 text-center">
      <p class="section-eyebrow text-white/60">Our Work</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4" style="font-family: var(--font-display)">
        Portfolio
      </h1>
      <p class="text-lg text-white/60 max-w-xl mx-auto">
        A showcase of events that define our craft and commitment to excellence.
      </p>
    </div>
  </section>

  <section class="section-padding" style="background: var(--color-bg)">
    <div class="container-narrow mx-auto">
      <div class="reveal">
        <PortfolioGrid client:load limit={12} />
      </div>
    </div>
  </section>
</BaseLayout>
